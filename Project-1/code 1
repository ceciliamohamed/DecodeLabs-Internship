import pandas as pd

# Load Dataset
df = pd.read_excel("Dataset for Data Analytics.xlsx")

print("=" * 50)
print("DATASET OVERVIEW")
print("=" * 50)

# Dataset Information
print("\nShape of Dataset:")
print(df.shape)

print("\nMissing Values:")
print(df.isnull().sum())

# --------------------------------------------------
# 1. Handle Missing Values
# --------------------------------------------------

# Replace missing CouponCode values
if 'CouponCode' in df.columns:
    df['CouponCode'] = df['CouponCode'].fillna('No Coupon')

# --------------------------------------------------
# 2. Remove Duplicates
# --------------------------------------------------

before_rows = len(df)

# Remove duplicate rows
df = df.drop_duplicates()

after_rows = len(df)

print(f"\nDuplicate Rows Removed: {before_rows - after_rows}")

# Check duplicate Order IDs
if 'OrderID' in df.columns:
    duplicate_ids = df['OrderID'].duplicated().sum()
    print(f"Duplicate Order IDs: {duplicate_ids}")

# --------------------------------------------------
# 3. Correct Data Formats
# --------------------------------------------------

# Convert Date column to datetime
if 'Date' in df.columns:
    df['Date'] = pd.to_datetime(df['Date'], errors='coerce')

# Numeric Columns
numeric_cols = ['Quantity', 'UnitPrice', 'TotalPrice']

for col in numeric_cols:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors='coerce')

# --------------------------------------------------
# 4. Validation Checks
# --------------------------------------------------

print("\nRemaining Missing Values:")
print(df.isnull().sum())

if 'OrderID' in df.columns:
    print("\nDuplicate IDs After Cleaning:")
    print(df['OrderID'].duplicated().sum())

if 'Date' in df.columns:
    invalid_dates = df['Date'].isnull().sum()
    print("\nInvalid Dates:")
    print(invalid_dates)

# --------------------------------------------------
# 5. Save Clean Dataset
# --------------------------------------------------

df.to_excel("Cleaned_Dataset.xlsx", index=False)

print("\nData Cleaning Completed Successfully!")
print("Cleaned file saved as: Cleaned_Dataset.xlsx")